# ---- Agent Autopsy backend configuration ----

ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./data/agent_autopsy.db

# LLM Configuration (Groq — free tier)
# Get a free API key at https://console.groq.com
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=45
# Other free Groq models: openai/gpt-oss-120b, qwen/qwen3.8-27b
# Legacy providers (paid): set LLM_PROVIDER=openai or LLM_PROVIDER=anthropic

# Ingestion & Security
MAX_UPLOAD_BYTES=10485760
REDACT_SECRETS=true
RETENTION_DAYS=90

# API Security
API_TOKEN=

# Rate Limiting
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ANALYZE=20

# CORS
CORS_ORIGINS=http://localhost:5173





