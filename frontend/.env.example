# Agent Autopsy — frontend environment
# Copy to .env.local to override. Values here are read at build time by Vite.

# Backend the dev server proxies /api to (default: http://127.0.0.1:8000).
VITE_API_TARGET=http://127.0.0.1:8000

# Only needed when the SPA is served from a different origin than the API,
# e.g. a static host. Leave empty to use the same-origin /api path (proxied in dev).
# VITE_API_BASE=http://127.0.0.1:8000/api
