# Copy to `.env` only if you need to override defaults.
# The deterministic pipeline works without any API key.
# Leave every value unset to use the offline baseline.

# ---------------------------------------------------------------------------
# SQLite case storage (optional override)
# ---------------------------------------------------------------------------
# HDA_DB_PATH=/absolute/path/to/cases.db

# ---------------------------------------------------------------------------
# LLM-assisted mode (optional)
# ---------------------------------------------------------------------------
# Set LLM_MODE=llm to enable LLM enrichment of issue analysis.
# Default is LLM_MODE=deterministic (no API key required).
# LLM_MODE=deterministic

# Required when LLM_MODE=llm. Never commit this value to source control.
# LLM_API_KEY=sk-...

# Optional: base URL for any OpenAI-API-compatible endpoint.
# Default: https://api.openai.com/v1
# LLM_BASE_URL=https://api.openai.com/v1

# Optional: model name to use. Default: gpt-4o-mini
# LLM_MODEL=gpt-4o-mini

# Optional: LLM request timeout in seconds. Default: 30
# LLM_TIMEOUT=30

# ---------------------------------------------------------------------------
# Real diagnostics (read-only, macOS only)
# ---------------------------------------------------------------------------
# Real diagnostics are opt-in per run (UI checkbox or allow_real=True in code).
# There is no environment switch that enables them globally.
