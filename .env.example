# Copy to `.env` only if you need to override defaults.
# This project never requires an LLM key; the deterministic pipeline works
# without one. Leave every value unset to use the offline baseline.

# Optional: override the SQLite case-history location.
# HDA_DB_PATH=/absolute/path/to/cases.db

# Optional: a hosted LLM is NOT implemented. These names exist so that a
# future optional integration cannot be confused with a working configuration.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Real diagnostics are opt-in per run (UI checkbox or `allow_real=True`).
# There is no environment switch that enables them globally.
